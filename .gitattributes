# Force LF line endings on imported reference files so checksums match
# across platforms (git autocrlf on Windows would otherwise convert to CRLF).
packages/agent-core/src/imported/** text eol=lf

# Normalize all source files to LF.
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
