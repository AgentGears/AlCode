{
  "name": "alcode",
  "version": "0.0.0",
  "private": true,
  "description": "A memory-native, verifier-driven coding agent. TypeScript end-to-end.",
  "license": "MIT",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "gate:0.0": "tsx scripts/gate/gate-0.0.ts",
    "gate:0.1A": "tsx scripts/gate/gate-0.1A.ts",
    "gate:0.2": "tsx scripts/gate/gate-0.2.ts",
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "fs-ext", "better-sqlite3"]
  },
  "devDependencies": {
    "@types/fs-ext": "^2.0.3",
    "@types/node": "^22.20.1",
    "fs-ext": "^2.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
